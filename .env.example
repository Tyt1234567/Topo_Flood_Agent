# Copy this file to .env and fill in your own values.
# .env is gitignored -- never commit your real one.

# Required: LLM backend (https://aistudio.google.com/apikey), free tier.
GEMINI_API_KEY=

# Optional: only needed for real stormwater pipe/catch-basin data
# (geoai_agent/drainage_db.py). Without it, that layer is silently skipped
# everywhere it's used -- same as any other missing data source.
# Format: postgresql://user:password@host:port/dbname
# See db_dump/README.md to restore the bundled sample dataset.
DATABASE_URL=

# Optional: only needed for the discrete-Morse (TTK) terrain analysis.
# Point these at a Python environment with TTK's VTK-based Python bindings
# installed (https://topology-tool-kit.github.io/), if it isn't at the
# defaults baked into geoai_agent/ttk_engine.py.
TTK_PYTHON=
TTK_BIN_DIR=

# Optional: only needed for the primary US elevation source (streamed USGS
# 3DEP DEM via GDAL). Point this at your QGIS install's python-qgis.bat, if
# it isn't at the default baked into geoai_agent/dem_cog_source.py. Without
# it, elevation automatically falls back to USGS's Elevation Point Query
# Service, then Open-Meteo.
QGIS_PYTHON=
